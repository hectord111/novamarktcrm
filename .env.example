# ─────────────────────────────────────────────────────────────
# Nova Marketing CRM — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# ─────────────────────────────────────────────────────────────

# Supabase — Auth (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://kdgbmctprtfawxipaupd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Service role (Settings → API). Solo servidor. Necesaria para invitar usuarios.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# Postgres — datos del CRM (Settings → Database → Connection string → URI)
# Usa el "Session pooler" o la conexión directa. El esquema es `nova`.
DATABASE_URL=postgresql://postgres.kdgbmctprtfawxipaupd:TU_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# WhatsApp Cloud API (opcional — sin esto funciona en modo simulación)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Meta Marketing API (opcional — para sincronizar campañas y gasto reales)
META_ACCESS_TOKEN=
# Token que tú eliges para verificar el webhook de Meta Lead Ads
META_VERIFY_TOKEN=nova-verify-token

# Seguridad de los endpoints de entrada (recomendado en producción)
LEAD_INTAKE_SECRET=
# Protege /api/automations/run y /api/meta/sync (cron)
CRON_SECRET=
